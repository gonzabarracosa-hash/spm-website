# Formspree endpoints for the contact form and newsletter signup.
# Create forms at https://formspree.io, then copy each form's endpoint URL
# here (e.g. https://formspree.io/f/xxxxxxxx). Leave blank during
# development — both forms still validate and show a success state, they
# just won't send anywhere until these are set.
NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_ENDPOINT=

# The site's real public URL once a domain is live (used for canonical links,
# Open Graph/Twitter card URLs, sitemap.xml and robots.txt). Falls back to a
# placeholder if unset — set this in Vercel once the domain is connected.
NEXT_PUBLIC_SITE_URL=https://www.spmdesignsolutions.com
